From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xiaren2 <xiaren2@local>
Date: Tue, 28 Oct 2026 00:00:00 +0800
Subject: [PATCH] firewall4: add flow offloading exclusions for IPs and
 devices

Add two new firewall defaults options:

  flow_offloading_exclude_ips       (list of IPv4 CIDRs)
  flow_offloading_exclude_devices   (list of device names)

Excluded IP ranges are emitted as negative matches on the flow offload
rule in the forward chain, so TCP/UDP flows to/from them are never
added to the flowtable (PPE) and stay on the software path.

Excluded devices are dropped from the flowtable device list, so any
flow ingressing on them is never offloaded.

Use case: hardware (PPE) offload breaks TCP to hosts reachable via the
plain ethernet WAN port (e.g. modem management subnet 192.168.1.0/24)
while internet access runs over PPPoE.
---
 root/usr/share/firewall4/templates/ruleset.uc | 3 ++-
 root/usr/share/ucode/fw4.uc                   | 7 +++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
index 0000000..0000000 100644
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -1,4 +1,5 @@
 	let flowtable_devices = fw4.resolve_offload_devices();
+	let offload_exclude_ips = fw4.default_option("flow_offloading_exclude_ips");
 	let available_helpers = filter(fw4.helpers(), h => h.available);
 	let defined_ipsets = fw4.ipsets();
 	let zones_with_limits = filter(fw4.zones(), z => z.log_limit);
@@ -135,7 +136,7 @@
 		type filter hook forward priority filter; policy {{ fw4.forward_policy(true) }};
 
 {% if (length(flowtable_devices) > 0): %}
-		meta l4proto { tcp, udp } flow offload @ft;
+		meta l4proto { tcp, udp }{% if (length(offload_exclude_ips)): %} ip saddr != { {{ join(', ', offload_exclude_ips) }} } ip daddr != { {{ join(', ', offload_exclude_ips) }} }{% endif %} flow offload @ft;
 {% endif %}
 {% fw4.includes('chain-prepend', 'forward') %}
 		ct state vmap { established : accept, related : accept{% if (fw4.default_option("drop_invalid")): %}, invalid : drop{% endif %} } comment "!fw4: Handle forwarded flows"
diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
index 0000000..0000000 100644
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -554,6 +554,11 @@
 			devices = sort(uniq(devices));
 		}
 
+		let excludes = this.default_option("flow_offloading_exclude_devices");
+
+		if (length(excludes))
+			devices = filter(devices, d => index(excludes, d) < 0);
+
 		return devices;
 	},
 
@@ -1971,6 +1976,8 @@
 			disable_ipv6: [ "bool", null, UNSUPPORTED ],
 			flow_offloading: [ "bool", "0" ],
 			flow_offloading_hw: [ "bool", "0" ],
+			flow_offloading_exclude_ips: [ "string", null, PARSE_LIST ],
+			flow_offloading_exclude_devices: [ "string", null, PARSE_LIST ],
 
 			auto_includes: [ "bool", "1" ]
 		});
-- 
