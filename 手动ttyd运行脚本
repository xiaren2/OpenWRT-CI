不加补丁，使用下面的脚本
#测试命令1
nft list chain inet fw4 forward
#测试命令2
nft list flowtables
#nft list flowtable inet fw4 ft

# 1. 关掉 fw4 自带的卸载
uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci commit firewall
# 2. 自建带排除规则的卸载表，允许访问光猫
cat > /etc/nftables.d/10-myoffload.nft <<'EOF'
flowtable myft {
    hook ingress priority filter;
    devices = { "lan1", "lan2", "lan3", "lan4", "phy0-ap0", "phy1-ap0", "pppoe-wan", "wan" };
    flags offload;
    counter;
}

chain myoffload {
    type filter hook forward priority filter + 10; policy accept;
    meta l4proto { tcp, udp } ip saddr != 192.168.1.1 ip daddr != 192.168.1.1 flow add @myft
}
EOF

/etc/init.d/firewall restart
#验证
nft list chain inet fw4 myoffload     # 我们的链在
nft list flowtable inet fw4 myft      # flowtable 在，flags offload
nft list chain inet fw4 forward | grep flow   # fw4 自己的链里没有 flow add 了
